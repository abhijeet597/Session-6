{
  "env": {
    "MONGODB_URI": "mongodb://localhost:27017/habit-tracker"
  },
  "model": "claude-sonnet-4-6",
  "statusLine": {
    "type": "command",
    "command": "echo \"habit-tracker · $(git branch --show-current)\""
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": ["Bash(npm run test:*)", "Bash(npm run lint:*)", "Bash(node:*)", "Write"],
    "deny": ["Bash(rm -rf:*)", "Read(./.env)"]
  },
  "sandbox": {
    "filesystem": { "write": ["./backend", "./client/src", "./reports"], "read": ["."] },
    "network": { "allow": ["registry.npmjs.org", "api.anthropic.com"] },
    "failIfUnavailable": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read(.env)",
        "hooks": [{ "type": "command", "command": "echo 'Blocked: .env read' >&2; exit 2" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write(*.{js,jsx})",
        "hooks": [{ "type": "command", "command": "npx prettier --write \"$CLAUDE_TOOL_ARG_path\"" }]
      }
    ]
  }
}
